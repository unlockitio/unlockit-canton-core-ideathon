-- | Initialization script for RETVN platform
-- Creates operator party and sets up test users with credentials
module Main where

import Daml.Script
import DA.Time
import W3C.VC
import RETVN.Role
import RETVN.Transaction

-- | Setup script - initializes the platform with operator and test users
setup : Script ()
setup = do
  -- Allocate operator party
  operator <- allocatePartyWithHint "Unlockit" (PartyIdHint "operator")

  -- Allocate test user parties
  alice <- allocatePartyWithHint "Alice" (PartyIdHint "alice")
  bob <- allocatePartyWithHint "Bob" (PartyIdHint "bob")
  charlie <- allocatePartyWithHint "Charlie" (PartyIdHint "charlie")

  debug "Allocated parties:"
  debug $ "Operator: " <> show operator
  debug $ "Alice: " <> show alice
  debug $ "Bob: " <> show bob
  debug $ "Charlie: " <> show charlie

  -- Get current time
  now <- getTime

  -- Create UserAccounts for test users
  -- Alice: RealtorAgent (can submit and verify)
  aliceAccount <- submit operator do
    createCmd UserAccount with
      operator = operator
      user = alice
      role = RealtorAgent
      verificationWeight = getVerificationWeight RealtorAgent
      credentialPresentations = []
      registeredAt = now
      status = AccountActive

  -- Bob: RealtorBroker (can submit and verify with higher weight)
  bobAccount <- submit operator do
    createCmd UserAccount with
      operator = operator
      user = bob
      role = RealtorBroker
      verificationWeight = getVerificationWeight RealtorBroker
      credentialPresentations = []
      registeredAt = now
      status = AccountActive

  -- Charlie: PrivateCitizen (can submit but not verify)
  charlieAccount <- submit operator do
    createCmd UserAccount with
      operator = operator
      user = charlie
      role = PrivateCitizen
      verificationWeight = getVerificationWeight PrivateCitizen
      credentialPresentations = []
      registeredAt = now
      status = AccountActive

  debug "Created UserAccounts:"
  debug $ "Alice (RealtorAgent): " <> show aliceAccount
  debug $ "Bob (RealtorBroker): " <> show bobAccount
  debug $ "Charlie (PrivateCitizen): " <> show charlieAccount

  return ()
