-- | Seed many transactions for testing
-- This script creates numerous realistic transaction proposals to populate the system
-- With realistic distribution:
-- - 5 Agents (RealtorAgent)
-- - 3 Brokers (RealtorBroker)
-- - 2 Masters (RealtorMaster)
-- - 3 Notaries (NotaryPublic)
-- - 1 Tax Authority (TaxAuthority)
-- - 10 Citizens (PrivateCitizen) - 5 heavy users with 18 tx each, 5 regular with 2 tx each
module SeedTransactions where

import Daml.Script
import DA.Time
import DA.Date (date, Month(..), addDays)
import DA.List
import qualified DA.Text
import DA.Foldable (forA_)
import DA.Action (when)
import RETVN.Transaction
import RETVN.Role
import W3C.VC

-- | Main seeding script - creates 100 realistic transactions
-- Note: Requires that SeedCredentials has been run first to create parties
seedTransactions : Script ()
seedTransactions = seedTransactionsWithCount 100

-- | Seeding script with configurable transaction count
seedTransactionsWithCount : Int -> Script ()
seedTransactionsWithCount count = do
  -- Get all known parties and find the ones we need by party ID string
  allParties <- listKnownParties

  let findParty name = case filter (\details -> show details.party == name || DA.Text.isInfixOf name (show details.party)) allParties of
        details::_ -> details.party
        [] -> error ("Party not found containing: " <> name <> ". Please run SeedCredentials script first!")

  -- Get all required parties
  let operator = findParty "operator"

  -- Agents (5) - NOT including alice or bob (they only have VCs)
  let agent1 = findParty "agent1"
  let agent2 = findParty "agent2"
  let agent3 = findParty "agent3"
  let agent4 = findParty "agent4"
  let agent5 = findParty "agent5"

  -- Brokers (3)
  let broker1 = findParty "broker1"
  let broker2 = findParty "broker2"
  let broker3 = findParty "broker3"

  -- Masters (2)
  let master1 = findParty "master1"
  let master2 = findParty "master2"

  -- Notaries (3)
  let notary1 = findParty "notary1"
  let notary2 = findParty "notary2"
  let notary3 = findParty "notary3"

  -- Tax Authority (1)
  let taxAuth = findParty "taxAuth"

  -- Get issuers (needed for credentials)
  let caDmv = findParty "caDmv"

  -- Get current time
  now <- getTime

  -- Create 10 citizens as parties
  -- 5 heavy users (18 transactions each = 90)
  -- 5 regular users (2 transactions each = 10)
  -- Total: 100 transactions
  let citizenNames = ["citizen1", "citizen2", "citizen3", "citizen4", "citizen5"
                     , "citizen6", "citizen7", "citizen8", "citizen9", "citizen10"]

  citizenParties <- forA citizenNames (\name -> allocateParty name)

  -- Create list of (Party, Name) pairs for easy reference
  let citizensWithNames = zip citizenParties citizenNames

  -- Create users for all citizens with simple names
  forA_ citizensWithNames (\(citizen, name) -> do
    citizenId <- validateUserId name
    createUser (User citizenId (Some citizen)) [CanActAs citizen]
    )

  -- ===== CREATE CREDENTIALS FOR ALL CITIZENS =====

  -- Helper function to create Government ID credential for citizens
  let createCitizenGovIdCredential holder holderName licenseNum = do
        let govIdProof = Proof with
              proofType = "Ed25519Signature2020"
              created = now
              proofPurpose = "assertionMethod"
              verificationMethod = "did:example:ca-dmv#key-1"
              proofValue = "mock-signature-gov-id-" <> holderName

        let govIdSubject = CredentialSubject with
              id = "did:example:" <> holderName
              claims =
                [ ("licenseNumber", licenseNum)
                , ("licenseClass", "C")
                , ("state", "California")
                , ("issueDate", "2020-01-15")
                ]

        govIdCid <- submit caDmv $ createCmd VerifiableCredential with
          credentialId = "urn:uuid:ca-dmv-dl-" <> licenseNum
          credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
          issuer = caDmv
          issuanceDate = now
          expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
          subject = govIdSubject
          proof = govIdProof
          status = Active
          holder = holder
          verifiers = [operator]
          credentialSchema = None
          credentialContext = ["https://www.w3.org/2018/credentials/v1"]

        govIdPresentation <- submit holder $ createCmd PresentationReceipt with
          credentialId = "urn:uuid:ca-dmv-dl-" <> licenseNum
          holder = holder
          verifier = operator
          presentedAt = now
          challenge = "registration-challenge-" <> holderName
          presentationProof = "mock-presentation-proof-" <> holderName <> "-govid"

        return govIdPresentation

  -- Create credentials for all citizens
  citizenCredentials <- forA citizensWithNames (\(citizen, name) -> do
    let licenseNum = "C" <> name <> "-DL-12345"
    createCitizenGovIdCredential citizen name licenseNum
    )

  -- Create UserAccount contracts for all citizens (with credentials)
  forA_ (zip citizenParties citizenCredentials) (\(citizen, credential) -> do
    submitMulti [operator, citizen] [] $ createCmd UserAccount with
      operator = operator
      user = citizen
      role = PrivateCitizen
      verificationWeight = getVerificationWeight PrivateCitizen
      credentialPresentations = [credential]
      registeredAt = now
      status = AccountActive
      reputation = getStartingReputation PrivateCitizen
      reputationCap = getReputationCap PrivateCitizen
      transactionsSubmitted = 0
    )

  -- Create submission and verification rights for all agents
  agent1SubmissionRight <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = agent1
    role = RealtorAgent
    verificationWeight = 8

  agent1VerificationRight <- submit operator $ createCmd TransactionVerificationRight with
    operator = operator
    user = agent1
    role = RealtorAgent
    verificationWeight = 8

  agent2SubmissionRight <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = agent2
    role = RealtorAgent
    verificationWeight = 8

  agent2VerificationRight <- submit operator $ createCmd TransactionVerificationRight with
    operator = operator
    user = agent2
    role = RealtorAgent
    verificationWeight = 8

  agent3SubmissionRight <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = agent3
    role = RealtorAgent
    verificationWeight = 8

  agent3VerificationRight <- submit operator $ createCmd TransactionVerificationRight with
    operator = operator
    user = agent3
    role = RealtorAgent
    verificationWeight = 8

  agent4SubmissionRight <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = agent4
    role = RealtorAgent
    verificationWeight = 8

  agent4VerificationRight <- submit operator $ createCmd TransactionVerificationRight with
    operator = operator
    user = agent4
    role = RealtorAgent
    verificationWeight = 8

  agent5SubmissionRight <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = agent5
    role = RealtorAgent
    verificationWeight = 8

  agent5VerificationRight <- submit operator $ createCmd TransactionVerificationRight with
    operator = operator
    user = agent5
    role = RealtorAgent
    verificationWeight = 8

  -- Create submission and verification rights for brokers
  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = broker1
    role = RealtorBroker
    verificationWeight = 15

  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = broker2
    role = RealtorBroker
    verificationWeight = 15

  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = broker3
    role = RealtorBroker
    verificationWeight = 15

  -- Create submission and verification rights for masters
  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = master1
    role = RealtorMaster
    verificationWeight = 20

  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = master2
    role = RealtorMaster
    verificationWeight = 20

  -- Create submission and verification rights for notaries
  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = notary1
    role = NotaryPublic
    verificationWeight = 25

  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = notary2
    role = NotaryPublic
    verificationWeight = 25

  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = notary3
    role = NotaryPublic
    verificationWeight = 25

  -- Create submission and verification rights for tax authority
  _ <- submit operator $ createCmd TransactionSubmissionRight with
    operator = operator
    user = taxAuth
    role = TaxAuthority
    verificationWeight = 40

  -- Create submission rights for ALL citizens (they all submit transactions)
  forA_ citizenParties (\citizen -> do
    submit operator $ createCmd TransactionSubmissionRight with
      operator = operator
      user = citizen
      role = PrivateCitizen
      verificationWeight = 5
    )

  -- ===== DATA CONFIGURATION =====
  -- Arrays and ranges for generating realistic transaction data

  -- Only use 2 postal codes for testing
  let postalCodes = ["94102", "90001"]

  let propertyTypes = [SingleFamily, Condo, Townhouse, MultiFamily, Land]

  -- Price ranges by property type (min, max)
  let getPriceRange propertyType : (Decimal, Decimal) = case propertyType of
        SingleFamily -> (500000.0, 1200000.0)
        Condo -> (350000.0, 800000.0)
        Townhouse -> (450000.0, 950000.0)
        MultiFamily -> (800000.0, 2000000.0)
        Land -> (200000.0, 600000.0)

  let bedroomOptions = [1, 2, 3, 4, 5, 6]
  let bathroomOptions = [1, 2, 3, 4, 5]

  -- Living area ranges (sqft)
  let livingAreaRanges = [(600, 1200), (1200, 1800), (1800, 2500), (2500, 3500), (3500, 5000)]

  -- Lot size ranges (sqft) - only for SingleFamily, Townhouse, MultiFamily, Land
  let lotSizeRanges = [(2000, 4000), (4000, 6000), (6000, 8000), (8000, 12000), (12000, 20000)]

  -- Year built ranges
  let yearBuiltRanges = [(1950, 1970), (1970, 1990), (1990, 2000), (2000, 2010), (2010, 2024)]

  -- Days on market range
  let daysOnMarketMin = 5
  let daysOnMarketMax = 90

  -- Financing types
  let financingTypes = ["Conventional", "FHA", "VA", "Cash", "USDA"]

  -- Street names and numbers for addresses
  let streetNumbers = ["123", "456", "789", "1011", "1234", "567", "890", "2345", "678", "901"
                      , "1111", "2222", "3333", "4444", "5555", "6666", "7777", "8888", "9999", "1001"]
  let streetNames =
        [ "Main St", "Oak Ave", "Maple Dr", "Pine Ct", "Cedar Ln"
        , "Elm St", "Birch Way", "Willow Rd", "Sunset Blvd", "Park Ave"
        , "Ocean View Dr", "Mountain Way", "Valley Rd", "Hill St", "Lake Dr"
        , "Beach Blvd", "Bay St", "River Rd", "Forest Ln", "Garden Ave"
        , "Market St", "Broadway", "First Ave", "Second St", "Third Ave"
        , "Park Pl", "Grove St", "Highland Ave", "Mission Blvd", "Castro St"
        ]

  -- ===== CONSISTENCY MAPPING =====
  -- Each agent is consistently associated with the same broker and master
  -- Agent -> (Broker, Master)
  let agentMapping =
        [ (agent1, broker1, master1)
        , (agent2, broker1, master1)
        , (agent3, broker2, master1)
        , (agent4, broker2, master2)
        , (agent5, broker3, master2)
        ]

  -- Notaries and Tax Authority for verifications (cycle through them)
  let verifierRoles =
        [ (notary1, NotaryPublic, 25)
        , (notary2, NotaryPublic, 25)
        , (notary3, NotaryPublic, 25)
        , (taxAuth, TaxAuthority, 40)
        ]

  -- ===== TRANSACTION DISTRIBUTION =====
  -- Build transaction list with realistic distribution:
  -- - Professionals (30 transactions): agents (15), brokers (6), masters (4), notaries (3), tax authority (2)
  -- - Citizens (70 transactions): 5 heavy users (12 each = 60), 5 regular users (2 each = 10)
  -- Total: 100 transactions

  -- Professional transactions (0-29)
  let professionalTransactions =
        -- Agents: 3 transactions each = 15 total
        [ (agent1, RealtorAgent, i) | i <- [0..2] ] <>
        [ (agent2, RealtorAgent, i) | i <- [3..5] ] <>
        [ (agent3, RealtorAgent, i) | i <- [6..8] ] <>
        [ (agent4, RealtorAgent, i) | i <- [9..11] ] <>
        [ (agent5, RealtorAgent, i) | i <- [12..14] ] <>
        -- Brokers: 2 transactions each = 6 total
        [ (broker1, RealtorBroker, i) | i <- [15..16] ] <>
        [ (broker2, RealtorBroker, i) | i <- [17..18] ] <>
        [ (broker3, RealtorBroker, i) | i <- [19..20] ] <>
        -- Masters: 2 transactions each = 4 total
        [ (master1, RealtorMaster, i) | i <- [21..22] ] <>
        [ (master2, RealtorMaster, i) | i <- [23..24] ] <>
        -- Notaries: 1 transaction each = 3 total
        [ (notary1, NotaryPublic, i) | i <- [25..25] ] <>
        [ (notary2, NotaryPublic, i) | i <- [26..26] ] <>
        [ (notary3, NotaryPublic, i) | i <- [27..27] ] <>
        -- Tax Authority: 2 transactions = 2 total
        [ (taxAuth, TaxAuthority, i) | i <- [28..29] ]

  -- Citizen transactions (30-99): 70 total
  let heavyUserTransactions =
        [ (citizenParties !! 0, PrivateCitizen, i) | i <- [30..41] ] <>  -- 12 transactions
        [ (citizenParties !! 1, PrivateCitizen, i) | i <- [42..53] ] <>  -- 12 transactions
        [ (citizenParties !! 2, PrivateCitizen, i) | i <- [54..65] ] <>  -- 12 transactions
        [ (citizenParties !! 3, PrivateCitizen, i) | i <- [66..77] ] <>  -- 12 transactions
        [ (citizenParties !! 4, PrivateCitizen, i) | i <- [78..89] ]     -- 12 transactions

  let regularUserTransactions =
        [ (citizenParties !! 5, PrivateCitizen, i) | i <- [90..91] ] <>  -- 2 transactions
        [ (citizenParties !! 6, PrivateCitizen, i) | i <- [92..93] ] <>  -- 2 transactions
        [ (citizenParties !! 7, PrivateCitizen, i) | i <- [94..95] ] <>  -- 2 transactions
        [ (citizenParties !! 8, PrivateCitizen, i) | i <- [96..97] ] <>  -- 2 transactions
        [ (citizenParties !! 9, PrivateCitizen, i) | i <- [98..99] ]     -- 2 transactions

  let allTransactionAssignments = professionalTransactions <> heavyUserTransactions <> regularUserTransactions

  -- ===== HELPER FUNCTIONS =====

  -- Generate a value within a range using index as seed
  let valueInRange idx (minVal, maxVal) =
        let range = maxVal - minVal
        in minVal + (idx % range)

      decimalInRange idx (minVal, maxVal) =
        let range = maxVal - minVal
            steps = 10000
            step = intToDecimal (idx % steps)
        in minVal + (step / intToDecimal steps * range)


  -- ===== TRANSACTION GENERATION =====

  let createTransaction (submitter, submitterRole, idx) = do
        -- Transaction submitted by either a citizen or a professional

        -- Assign an agent to this transaction (cycle through 5 agents)
        let agentIdx = idx % 5
        let (agent, broker, master) = agentMapping !! agentIdx

        -- Select property type (cycle through all types)
        let propertyType = propertyTypes !! (idx % 5)

        -- Select postal code (cycle between 2 codes)
        let postalCode = postalCodes !! (idx % 2)

        -- Generate property address
        let streetNumber = streetNumbers !! ((idx / 5) % 20)
        let streetName = streetNames !! ((idx / 3) % 30)
        let propertyAddress = streetNumber <> " " <> streetName

        -- Generate price within range for property type
        let (priceMin, priceMax) = getPriceRange propertyType
        let salePrice = decimalInRange (idx * 7) (priceMin, priceMax)

        -- Generate bedrooms (property type dependent)
        let bedrooms = case propertyType of
              Land -> None
              Condo -> Some (bedroomOptions !! (idx % 3))  -- 1-3 bedrooms
              SingleFamily -> Some (bedroomOptions !! ((idx % 5) + 1))  -- 2-6 bedrooms
              Townhouse -> Some (bedroomOptions !! ((idx % 4) + 1))  -- 2-5 bedrooms
              MultiFamily -> Some (bedroomOptions !! ((idx % 4) + 2))  -- 3-6 bedrooms

        -- Generate bathrooms
        let bathrooms = case propertyType of
              Land -> None
              _ -> Some (bathroomOptions !! (idx % 5))

        -- Generate living area
        let livingArea = case propertyType of
              Land -> None
              _ -> let rangeIdx = idx % 5
                       (minSqft, maxSqft) = livingAreaRanges !! rangeIdx
                   in Some (valueInRange (idx * 3) (minSqft, maxSqft))

        -- Generate lot size (not for condos)
        let lotSize = case propertyType of
              Condo -> None
              _ -> let rangeIdx = idx % 5
                       (minLot, maxLot) = lotSizeRanges !! rangeIdx
                   in Some (valueInRange (idx * 5) (minLot, maxLot))

        -- Generate year built
        let yearBuilt = case propertyType of
              Land -> None
              _ -> let rangeIdx = idx % 5
                       (minYear, maxYear) = yearBuiltRanges !! rangeIdx
                   in Some (valueInRange (idx * 11) (minYear, maxYear))

        -- Generate days on market
        let daysOnMarket = Some (valueInRange (idx * 13) (daysOnMarketMin, daysOnMarketMax))

        -- Generate financing type
        let financingType = Some (financingTypes !! (idx % 5))

        -- Generate transaction date based on idx % 3
        -- 0: < 29 days from now (recent)
        -- 1: < 364 days from now (year)
        -- 2: >= 366 days from now (historic)
        let txTime = case idx % 3 of
              0 -> addRelTime now (days (- (idx % 29)))           -- 0-28 days ago
              1 -> addRelTime now (days (- (30 + (idx % 334))))   -- 30-363 days ago
              _ -> addRelTime now (days (- (366 + (idx % 365))))  -- 366-730 days ago

        -- Generate closing date (30 days after transaction)
        let closingDate = Some (addRelTime txTime (days 30))

        -- Assign verifiers: agent, broker, master, and one rotating notary/taxAuth
        let verifierIdx = idx % 4
        let (additionalVerifier, additionalRole, additionalWeight) = verifierRoles !! verifierIdx
        let proposedVerifiers = [agent, broker, master, additionalVerifier]

        -- Transaction ID
        let transactionId = "TX-" <> show idx <> "-2024"

        -- Create initial verification from submitter
        let submitterVerification = Verification with
              verifier = submitter
              verifierRole = submitterRole
              verificationWeight = getVerificationWeight submitterRole
              decision = Confirmed
              notes = None
              verifiedAt = now

        -- Create verification from agent (only if agent is not the submitter)
        let agentVerification = if agent /= submitter
              then Some (Verification with
                    verifier = agent
                    verifierRole = RealtorAgent
                    verificationWeight = 8
                    decision = Confirmed
                    notes = None
                    verifiedAt = now)
              else None

        let allVerifiers = dedup (submitter :: proposedVerifiers)
        let initialVerifications = case agentVerification of
              Some av -> [submitterVerification, av]
              None -> [submitterVerification]
        let initialTrustScore = calculateTrustScore initialVerifications
        let initialStatus = determineStatus initialVerifications

        -- Create TransactionData directly
        submitMulti [operator, submitter] [] $ createCmd TransactionData with
          operator = operator
          submitter = submitter
          submitterRole = submitterRole
          transactionId = transactionId
          propertyAddress = propertyAddress
          postalCode = postalCode
          propertyType = propertyType
          livingAreaSqft = livingArea
          lotSizeSqft = lotSize
          bedroomsTotal = bedrooms
          bathroomsTotal = bathrooms
          yearBuilt = yearBuilt
          salePrice = salePrice
          transactionDate = txTime
          closingDate = closingDate
          financingType = financingType
          daysOnMarket = daysOnMarket
          assignedVerifiers = allVerifiers
          verifications = initialVerifications
          trustScore = initialTrustScore
          status = initialStatus
          submittedAt = now

  -- Generate transactions based on distribution
  -- Use allTransactionAssignments which has the realistic distribution
  transactionCids <- forA allTransactionAssignments createTransaction

  debug ("Successfully created " <> show count <> " TransactionData contracts!")
  debug "Now applying verifications to create varied reputation..."

  -- Apply additional verifications to simulate real activity
  -- This will update submitters' reputation values
  forA_ allTransactionAssignments (\(submitter, submitterRole, idx) -> do
    -- Determine which verifiers should verify based on idx
    -- For variety: 60% get broker verification, 40% get master verification, 20% get notary/tax verification
    let shouldBrokerVerify = (idx % 10) < 6
    let shouldMasterVerify = (idx % 10) < 4
    let shouldAdditionalVerify = (idx % 10) < 2

    -- Find broker, master, and additional verifier from assigned verifiers
    let agentIdx = idx % 5
    let (agent, broker, master) = agentMapping !! agentIdx
    let verifierIdx = idx % 4
    let (additionalVerifier, additionalRole, additionalWeight) = verifierRoles !! verifierIdx

    -- Get UserAccount for submitter (to pass to ApplyVerification)
    -- Note: we will re-query this account before each verification because ApplyVerification
    -- may exercise UpdateReputation on the submitter's UserAccount, which consumes and
    -- recreates the account ContractId. Using a stale ContractId causes CONTRACT_NOT_FOUND.
    submitterAccounts <- query @UserAccount operator
    let submitterAccount = find (\(_, acc) -> acc.user == submitter) submitterAccounts

    case submitterAccount of
      Some (_, _) -> do
        -- Get UserAccounts for verifiers (we will re-query submitter account as needed)
        verifierAccounts <- query @UserAccount operator

        -- Helper to fetch latest submitter account id
        let fetchLatestSubmitterAccount = do
              s <- query @UserAccount operator
              return $ find (\(_, acc) -> acc.user == submitter) s

        -- Apply broker verification if conditions met
        when (shouldBrokerVerify && broker /= submitter) $ do
          let brokerAccount = find (\(_, acc) -> acc.user == broker) verifierAccounts
          case brokerAccount of
            Some (brokerAccId, _) -> do
              -- Query for the current transaction contract
              tx <- query @TransactionData operator
              let txData = find (\(_, t) -> t.transactionId == ("TX-" <> show idx <> "-2024")) tx
              case txData of
                Some (currentTxCid, currentTxContract) -> do
                  when (broker `notElem` (map (\v -> v.verifier) currentTxContract.verifications)) $ do
                    -- Re-fetch the submitter account id just before exercising
                    latestSubmitter <- fetchLatestSubmitterAccount
                    case latestSubmitter of
                      Some (submitterAccId, _) -> do
                        _ <- submit operator $ exerciseCmd currentTxCid ApplyVerification with
                          verifier = broker
                          verifierAccount = brokerAccId
                          submitterAccount = submitterAccId
                          decision = Confirmed
                          notes = None
                          verifiedAt = now
                        return ()
                      None -> return ()
                None -> return ()
            None -> return ()

        -- Apply master verification if conditions met
        when (shouldMasterVerify && master /= submitter) $ do
          let masterAccount = find (\(_, acc) -> acc.user == master) verifierAccounts
          case masterAccount of
            Some (masterAccId, _) -> do
              -- Query for the current transaction contract (may have been updated by broker)
              tx <- query @TransactionData operator
              let txData = find (\(_, t) -> t.transactionId == ("TX-" <> show idx <> "-2024")) tx
              case txData of
                Some (currentTxCid, currentTxContract) -> do
                  when (master `notElem` (map (\v -> v.verifier) currentTxContract.verifications)) $ do
                    -- Re-fetch the submitter account id just before exercising
                    latestSubmitter <- fetchLatestSubmitterAccount
                    case latestSubmitter of
                      Some (submitterAccId, _) -> do
                        _ <- submit operator $ exerciseCmd currentTxCid ApplyVerification with
                          verifier = master
                          verifierAccount = masterAccId
                          submitterAccount = submitterAccId
                          decision = Confirmed
                          notes = None
                          verifiedAt = now
                        return ()
                      None -> return ()
                None -> return ()
            None -> return ()

        -- Apply additional verifier (notary/tax) verification if conditions met
        when (shouldAdditionalVerify && additionalVerifier /= submitter) $ do
          let additionalAccount = find (\(_, acc) -> acc.user == additionalVerifier) verifierAccounts
          case additionalAccount of
            Some (additionalAccId, _) -> do
              -- Query for the current transaction contract (may have been updated)
              tx <- query @TransactionData operator
              let txData = find (\(_, t) -> t.transactionId == ("TX-" <> show idx <> "-2024")) tx
              case txData of
                Some (currentTxCid, currentTxContract) -> do
                  when (additionalVerifier `notElem` (map (\v -> v.verifier) currentTxContract.verifications)) $ do
                    -- Re-fetch the submitter account id just before exercising
                    latestSubmitter <- fetchLatestSubmitterAccount
                    case latestSubmitter of
                      Some (submitterAccId, _) -> do
                        _ <- submit operator $ exerciseCmd currentTxCid ApplyVerification with
                          verifier = additionalVerifier
                          verifierAccount = additionalAccId
                          submitterAccount = submitterAccId
                          decision = Confirmed
                          notes = None
                          verifiedAt = now
                        return ()
                      None -> return ()
                None -> return ()
            None -> return ()

        return ()
      None -> return ()
    )

  debug "Verifications applied!"
  debug "ALL citizen users now have valid credentials!"
  debug "  - All 10 citizens have Government ID credentials"
  debug "Distribution:"
  debug "  Professionals (30 transactions):"
  debug "    - Agents: 3 each = 15 total"
  debug "    - Brokers: 2 each = 6 total"
  debug "    - Masters: 2 each = 4 total"
  debug "    - Notaries: 1 each = 3 total"
  debug "    - Tax Authority: 2 total"
  debug "  Citizens (70 transactions):"
  debug "    - 5 heavy users: 12 each = 60 total"
  debug "    - 5 regular users: 2 each = 10 total"
  debug "Consistency: Each agent always uses the same broker and master"
  debug ("Agent mappings:")
  debug ("  agent1 -> broker1 -> master1")
  debug ("  agent2 -> broker1 -> master1")
  debug ("  agent3 -> broker2 -> master1")
  debug ("  agent4 -> broker2 -> master2")
  debug ("  agent5 -> broker3 -> master2")
  debug ("NOTE: alice and bob have VCs only - not used in transactions")
  return ()
