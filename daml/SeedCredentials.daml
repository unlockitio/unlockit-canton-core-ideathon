-- | Seed test credentials for development and testing
-- This script creates a realistic distribution of parties:
-- - Alice and Bob: VCs ONLY (no UserAccount) - for testing credential verification
-- - 5 Agents (RealtorAgent): agent1-5
-- - 3 Brokers (RealtorBroker)
-- - 2 Masters (RealtorMaster)
-- - 3 Notaries (NotaryPublic)
-- - 1 Tax Authority (TaxAuthority)
-- Citizens are created in SeedTransactions script
module SeedCredentials where

import Daml.Script
import DA.Time
import DA.Date (date, Month(..))
import W3C.VC
import RETVN.Role

-- | Main seeding script - creates test credentials for realistic scenario
-- Alice and Bob: Parties with VCs only (no users, no UserAccount contracts)
--   - They exist as parties to own credentials but won't show up in /v2/users/ API
--   - Alice: Government ID, RE License, Brokerage Affiliation
--   - Bob: Government ID only
-- Professional users (Agents, Brokers, Masters, Notaries, Tax Authority): full users with UserAccount contracts and credentials
-- Run this on a fresh ledger or after parties have been created
seedTestCredentials : Script ()
seedTestCredentials = do
  -- Allocate parties - will fail if they already exist, which is expected
  -- To handle existing parties, run this only once on fresh ledger
  operator <- allocateParty "operator"

  -- Alice and Bob (VCs only, no UserAccount)
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"

  -- Agents (5) - not including alice/bob
  agent1 <- allocateParty "agent1"
  agent2 <- allocateParty "agent2"
  agent3 <- allocateParty "agent3"
  agent4 <- allocateParty "agent4"
  agent5 <- allocateParty "agent5"

  -- Brokers (3)
  broker1 <- allocateParty "broker1"
  broker2 <- allocateParty "broker2"
  broker3 <- allocateParty "broker3"

  -- Masters (2)
  master1 <- allocateParty "master1"
  master2 <- allocateParty "master2"

  -- Notaries (3)
  notary1 <- allocateParty "notary1"
  notary2 <- allocateParty "notary2"
  notary3 <- allocateParty "notary3"

  -- Tax Authority (1)
  taxAuth <- allocateParty "taxAuth"

  -- Issuers
  caDmv <- allocateParty "caDmv"
  caDre <- allocateParty "caDre"
  kw <- allocateParty "kw"
  reMax <- allocateParty "reMax"
  century21 <- allocateParty "century21"

  -- Create users for all parties (except alice and bob - they only exist as parties to own VCs)
  operatorId <- validateUserId "operator"
  agent1Id <- validateUserId "agent1"
  agent2Id <- validateUserId "agent2"
  agent3Id <- validateUserId "agent3"
  agent4Id <- validateUserId "agent4"
  agent5Id <- validateUserId "agent5"
  broker1Id <- validateUserId "broker1"
  broker2Id <- validateUserId "broker2"
  broker3Id <- validateUserId "broker3"
  master1Id <- validateUserId "master1"
  master2Id <- validateUserId "master2"
  notary1Id <- validateUserId "notary1"
  notary2Id <- validateUserId "notary2"
  notary3Id <- validateUserId "notary3"
  taxAuthId <- validateUserId "taxAuth"
  caDmvId <- validateUserId "caDmv"
  caDreId <- validateUserId "caDre"
  kwId <- validateUserId "kw"
  reMaxId <- validateUserId "reMax"
  century21Id <- validateUserId "century21"

  createUser (User operatorId (Some operator)) [CanActAs operator]
  createUser (User agent1Id (Some agent1)) [CanActAs agent1]
  createUser (User agent2Id (Some agent2)) [CanActAs agent2]
  createUser (User agent3Id (Some agent3)) [CanActAs agent3]
  createUser (User agent4Id (Some agent4)) [CanActAs agent4]
  createUser (User agent5Id (Some agent5)) [CanActAs agent5]
  createUser (User broker1Id (Some broker1)) [CanActAs broker1]
  createUser (User broker2Id (Some broker2)) [CanActAs broker2]
  createUser (User broker3Id (Some broker3)) [CanActAs broker3]
  createUser (User master1Id (Some master1)) [CanActAs master1]
  createUser (User master2Id (Some master2)) [CanActAs master2]
  createUser (User notary1Id (Some notary1)) [CanActAs notary1]
  createUser (User notary2Id (Some notary2)) [CanActAs notary2]
  createUser (User notary3Id (Some notary3)) [CanActAs notary3]
  createUser (User taxAuthId (Some taxAuth)) [CanActAs taxAuth]
  createUser (User caDmvId (Some caDmv)) [CanActAs caDmv]
  createUser (User caDreId (Some caDre)) [CanActAs caDre]
  createUser (User kwId (Some kw)) [CanActAs kw]
  createUser (User reMaxId (Some reMax)) [CanActAs reMax]
  createUser (User century21Id (Some century21)) [CanActAs century21]

  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kw $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kw
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create PresentationReceipts for Alice (credential presentations to operator)
  aliceGovIdPresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-govid"

  aliceRELicensePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-re-license"

  aliceBrokeragePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:kw-affiliation-12345"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-brokerage"

  -- ===== CREATE CREDENTIALS FOR BOB (VCs only, no UserAccount) =====

  -- 1. Bob's Government ID
  let bobGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-bob"

  let bobGovIdSubject = CredentialSubject with
        id = "did:example:bob"
        claims =
          [ ("licenseNumber", "D9876543")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2021-03-20")
          ]

  bobGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d9876543"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2029 Mar 20) 0 0 0)
    subject = bobGovIdSubject
    proof = bobGovIdProof
    status = Active
    holder = bob
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  bobGovIdPresentation <- submit bob $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d9876543"
    holder = bob
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-bob"
    presentationProof = "mock-presentation-proof-bob-govid"

  -- ===== CREATE CREDENTIALS FOR ALL OTHER USERS =====

  -- Helper function to create Government ID credential
  let createGovIdCredential holder holderName licenseNum = do
        let govIdProof = Proof with
              proofType = "Ed25519Signature2020"
              created = now
              proofPurpose = "assertionMethod"
              verificationMethod = "did:example:ca-dmv#key-1"
              proofValue = "mock-signature-gov-id-" <> holderName

        let govIdSubject = CredentialSubject with
              id = "did:example:" <> holderName
              claims =
                [ ("licenseNumber", licenseNum)
                , ("licenseClass", "C")
                , ("state", "California")
                , ("issueDate", "2020-01-15")
                ]

        govIdCid <- submit caDmv $ createCmd VerifiableCredential with
          credentialId = "urn:uuid:ca-dmv-dl-" <> licenseNum
          credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
          issuer = caDmv
          issuanceDate = now
          expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
          subject = govIdSubject
          proof = govIdProof
          status = Active
          holder = holder
          verifiers = [operator]
          credentialSchema = None
          credentialContext = ["https://www.w3.org/2018/credentials/v1"]

        govIdPresentation <- submit holder $ createCmd PresentationReceipt with
          credentialId = "urn:uuid:ca-dmv-dl-" <> licenseNum
          holder = holder
          verifier = operator
          presentedAt = now
          challenge = "registration-challenge-" <> holderName
          presentationProof = "mock-presentation-proof-" <> holderName <> "-govid"

        return govIdPresentation

  -- Helper function to create Real Estate License credential
  let createRELicenseCredential holder holderName licenseNum licenseType = do
        let reLicenseProof = Proof with
              proofType = "Ed25519Signature2020"
              created = now
              proofPurpose = "assertionMethod"
              verificationMethod = "did:example:ca-dre#key-1"
              proofValue = "mock-signature-re-license-" <> holderName

        let reLicenseSubject = CredentialSubject with
              id = "did:example:" <> holderName
              claims =
                [ ("licenseNumber", licenseNum)
                , ("licenseType", licenseType)
                , ("state", "California")
                , ("issueDate", "2023-01-15")
                ]

        reLicenseCid <- submit caDre $ createCmd VerifiableCredential with
          credentialId = "urn:uuid:ca-dre-" <> holderName <> "-" <> licenseNum
          credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
          issuer = caDre
          issuanceDate = now
          expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
          subject = reLicenseSubject
          proof = reLicenseProof
          status = Active
          holder = holder
          verifiers = [operator]
          credentialSchema = None
          credentialContext = ["https://www.w3.org/2018/credentials/v1"]

        reLicensePresentation <- submit holder $ createCmd PresentationReceipt with
          credentialId = "urn:uuid:ca-dre-" <> holderName <> "-" <> licenseNum
          holder = holder
          verifier = operator
          presentedAt = now
          challenge = "registration-challenge-" <> holderName
          presentationProof = "mock-presentation-proof-" <> holderName <> "-re-license"

        return reLicensePresentation

  -- Helper function to create Brokerage Affiliation credential
  let createBrokerageAffiliation holder holderName affiliationId brokerageName = do
        let brokerageProof = Proof with
              proofType = "Ed25519Signature2020"
              created = now
              proofPurpose = "assertionMethod"
              verificationMethod = "did:example:kw#key-1"
              proofValue = "mock-signature-brokerage-" <> holderName

        let brokerageSubject = CredentialSubject with
              id = "did:example:" <> holderName
              claims =
                [ ("affiliationId", affiliationId)
                , ("brokerageName", brokerageName)
                , ("office", "California")
                ]

        brokerageCid <- submit kw $ createCmd VerifiableCredential with
          credentialId = "urn:uuid:kw-affiliation-" <> affiliationId
          credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
          issuer = kw
          issuanceDate = now
          expirationDate = None
          subject = brokerageSubject
          proof = brokerageProof
          status = Active
          holder = holder
          verifiers = [operator]
          credentialSchema = None
          credentialContext = ["https://www.w3.org/2018/credentials/v1"]

        brokeragePresentation <- submit holder $ createCmd PresentationReceipt with
          credentialId = "urn:uuid:kw-affiliation-" <> affiliationId
          holder = holder
          verifier = operator
          presentedAt = now
          challenge = "registration-challenge-" <> holderName
          presentationProof = "mock-presentation-proof-" <> holderName <> "-brokerage"

        return brokeragePresentation

  -- Create credentials for agent1
  agent1GovId <- createGovIdCredential agent1 "agent1" "D1134568"
  agent1RELicense <- createRELicenseCredential agent1 "agent1" "02056790" "Real Estate Agent"
  agent1Brokerage <- createBrokerageAffiliation agent1 "agent1" "KW-CA-12345" "Keller Williams Realty"

  -- Create credentials for agent2
  agent2GovId <- createGovIdCredential agent2 "agent2" "D2234567"
  agent2RELicense <- createRELicenseCredential agent2 "agent2" "02156789" "Real Estate Agent"
  agent2Brokerage <- createBrokerageAffiliation agent2 "agent2" "KW-CA-12346" "Keller Williams Realty"

  -- Create credentials for agent3
  agent3GovId <- createGovIdCredential agent3 "agent3" "D3234567"
  agent3RELicense <- createRELicenseCredential agent3 "agent3" "02256789" "Real Estate Agent"
  agent3Brokerage <- createBrokerageAffiliation agent3 "agent3" "KW-CA-12347" "Keller Williams Realty"

  -- Create credentials for agent4
  agent4GovId <- createGovIdCredential agent4 "agent4" "D4234567"
  agent4RELicense <- createRELicenseCredential agent4 "agent4" "02356789" "Real Estate Agent"
  agent4Brokerage <- createBrokerageAffiliation agent4 "agent4" "KW-CA-12348" "Keller Williams Realty"

  -- Create credentials for agent5
  agent5GovId <- createGovIdCredential agent5 "agent5" "D5234567"
  agent5RELicense <- createRELicenseCredential agent5 "agent5" "02456789" "Real Estate Agent"
  agent5Brokerage <- createBrokerageAffiliation agent5 "agent5" "KW-CA-12349" "Keller Williams Realty"

  -- Create credentials for broker1
  broker1GovId <- createGovIdCredential broker1 "broker1" "D6234567"
  broker1RELicense <- createRELicenseCredential broker1 "broker1" "01056789" "Real Estate Broker"
  broker1Brokerage <- createBrokerageAffiliation broker1 "broker1" "RM-CA-12345" "RE/MAX Realty"

  -- Create credentials for broker2
  broker2GovId <- createGovIdCredential broker2 "broker2" "D7234567"
  broker2RELicense <- createRELicenseCredential broker2 "broker2" "01156789" "Real Estate Broker"
  broker2Brokerage <- createBrokerageAffiliation broker2 "broker2" "RM-CA-12346" "RE/MAX Realty"

  -- Create credentials for broker3
  broker3GovId <- createGovIdCredential broker3 "broker3" "D8234567"
  broker3RELicense <- createRELicenseCredential broker3 "broker3" "01256789" "Real Estate Broker"
  broker3Brokerage <- createBrokerageAffiliation broker3 "broker3" "C21-CA-12345" "Century 21"

  -- Create credentials for master1
  master1GovId <- createGovIdCredential master1 "master1" "D9234567"
  master1RELicense <- createRELicenseCredential master1 "master1" "00156789" "Master Realtor"

  -- Create credentials for master2
  master2GovId <- createGovIdCredential master2 "master2" "D1034567"
  master2RELicense <- createRELicenseCredential master2 "master2" "00256789" "Master Realtor"

  -- Create credentials for notary1
  notary1GovId <- createGovIdCredential notary1 "notary1" "D1134567"

  -- Create credentials for notary2
  notary2GovId <- createGovIdCredential notary2 "notary2" "D1234568"

  -- Create credentials for notary3
  notary3GovId <- createGovIdCredential notary3 "notary3" "D1334567"

  -- Create credentials for taxAuth
  taxAuthGovId <- createGovIdCredential taxAuth "taxAuth" "D1434567"

  -- Create UserAccounts for agents (with full credentials)
  agent1Account <- submitMulti [operator, agent1] [] $ createCmd UserAccount with
    operator = operator
    user = agent1
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = [agent1GovId, agent1RELicense, agent1Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent2Account <- submitMulti [operator, agent2] [] $ createCmd UserAccount with
    operator = operator
    user = agent2
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = [agent2GovId, agent2RELicense, agent2Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent3Account <- submitMulti [operator, agent3] [] $ createCmd UserAccount with
    operator = operator
    user = agent3
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = [agent3GovId, agent3RELicense, agent3Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent4Account <- submitMulti [operator, agent4] [] $ createCmd UserAccount with
    operator = operator
    user = agent4
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = [agent4GovId, agent4RELicense, agent4Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent5Account <- submitMulti [operator, agent5] [] $ createCmd UserAccount with
    operator = operator
    user = agent5
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = [agent5GovId, agent5RELicense, agent5Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  -- Create UserAccounts for brokers
  broker1Account <- submitMulti [operator, broker1] [] $ createCmd UserAccount with
    operator = operator
    user = broker1
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = [broker1GovId, broker1RELicense, broker1Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  broker2Account <- submitMulti [operator, broker2] [] $ createCmd UserAccount with
    operator = operator
    user = broker2
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = [broker2GovId, broker2RELicense, broker2Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  broker3Account <- submitMulti [operator, broker3] [] $ createCmd UserAccount with
    operator = operator
    user = broker3
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = [broker3GovId, broker3RELicense, broker3Brokerage]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  -- Create UserAccounts for masters
  master1Account <- submitMulti [operator, master1] [] $ createCmd UserAccount with
    operator = operator
    user = master1
    role = RealtorMaster
    verificationWeight = getVerificationWeight RealtorMaster
    credentialPresentations = [master1GovId, master1RELicense]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorMaster
    reputationCap = getReputationCap RealtorMaster
    transactionsSubmitted = 0

  master2Account <- submitMulti [operator, master2] [] $ createCmd UserAccount with
    operator = operator
    user = master2
    role = RealtorMaster
    verificationWeight = getVerificationWeight RealtorMaster
    credentialPresentations = [master2GovId, master2RELicense]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorMaster
    reputationCap = getReputationCap RealtorMaster
    transactionsSubmitted = 0

  -- Create UserAccounts for notaries
  notary1Account <- submitMulti [operator, notary1] [] $ createCmd UserAccount with
    operator = operator
    user = notary1
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = [notary1GovId]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  notary2Account <- submitMulti [operator, notary2] [] $ createCmd UserAccount with
    operator = operator
    user = notary2
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = [notary2GovId]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  notary3Account <- submitMulti [operator, notary3] [] $ createCmd UserAccount with
    operator = operator
    user = notary3
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = [notary3GovId]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  -- Create UserAccount for tax authority
  taxAuthAccount <- submitMulti [operator, taxAuth] [] $ createCmd UserAccount with
    operator = operator
    user = taxAuth
    role = TaxAuthority
    verificationWeight = getVerificationWeight TaxAuthority
    credentialPresentations = [taxAuthGovId]
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation TaxAuthority
    reputationCap = getReputationCap TaxAuthority
    transactionsSubmitted = 0

  debug "Successfully seeded test credentials and user accounts!"
  debug ("Alice and Bob: Parties with VCs ONLY (no users, no UserAccount)")
  debug ("  - They exist as parties to own credentials but won't show up in /v2/users/")
  debug ("  - Alice: Gov ID, RE Agent License, Brokerage Affiliation")
  debug ("  - Bob: Gov ID only")
  debug ("ALL professional users now have valid credentials:")
  debug ("Agents (with Gov ID, RE License, Brokerage): agent1, agent2, agent3, agent4, agent5")
  debug ("Brokers (with Gov ID, RE License, Brokerage): broker1, broker2, broker3")
  debug ("Masters (with Gov ID, RE License): master1, master2")
  debug ("Notaries (with Gov ID): notary1, notary2, notary3")
  debug ("Tax Authority (with Gov ID): taxAuth")

  return ()
