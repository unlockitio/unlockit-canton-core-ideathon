-- | Seed test credentials for development and testing
-- This script creates test VerifiableCredential contracts for alice and bob
module SeedCredentials where

import Daml.Script
import DA.Time
import DA.Date (date, Month(..))
import W3C.VC
import RETVN.Role

-- | Main seeding script - creates test credentials for alice and bob
-- Run this on a fresh ledger or after parties have been created
seedTestCredentials : Script ()
seedTestCredentials = do
  -- Allocate parties - will fail if they already exist, which is expected
  -- To handle existing parties, run this only once on fresh ledger
  operator <- allocateParty "operator"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  caDmv <- allocateParty "CA_DMV"
  caDre <- allocateParty "CA_DRE"
  kellerWilliams <- allocateParty "KELLER_WILLIAMS"

  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kellerWilliams $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kellerWilliams
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Bob (Private Citizen)

  -- 1. Bob's Government ID
  let bobGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-bob"

  let bobGovIdSubject = CredentialSubject with
        id = "did:example:bob"
        claims =
          [ ("licenseNumber", "D7654321")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2019-03-20")
          ]

  bobGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2029 Mar 20) 0 0 0)
    subject = bobGovIdSubject
    proof = bobGovIdProof
    status = Active
    holder = bob
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create PresentationReceipts for Alice (credential presentations to operator)
  aliceGovIdPresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-govid"

  aliceRELicensePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-re-license"

  aliceBrokeragePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:kw-affiliation-12345"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-brokerage"

  -- Create Alice's RegistrationRequest
  aliceRegistrationRequest <- submit alice $ createCmd RegistrationRequest with
    operator = operator
    user = alice
    requestedRole = RealtorAgent
    credentialPresentations = [aliceGovIdPresentation, aliceRELicensePresentation, aliceBrokeragePresentation]
    requestedAt = now

  -- Operator approves Alice's registration
  aliceAccount <- submit operator $ exerciseCmd aliceRegistrationRequest ApproveRegistration

  -- Create PresentationReceipt for Bob
  bobGovIdPresentation <- submit bob $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    holder = bob
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-bob"
    presentationProof = "mock-presentation-proof-bob-govid"

  -- Create Bob's RegistrationRequest
  bobRegistrationRequest <- submit bob $ createCmd RegistrationRequest with
    operator = operator
    user = bob
    requestedRole = PrivateCitizen
    credentialPresentations = [bobGovIdPresentation]
    requestedAt = now

  -- Operator approves Bob's registration
  bobAccount <- submit operator $ exerciseCmd bobRegistrationRequest ApproveRegistration

  debug "Successfully seeded test credentials and user accounts!"
  debug ("Alice credentials: " <> show [aliceGovIdCid, aliceRELicenseCid, aliceBrokerageCid])
  debug ("Bob credentials: " <> show [bobGovIdCid])
  debug ("Alice account: " <> show aliceAccount)
  debug ("Bob account: " <> show bobAccount)

  return ()

-- | Alternative seeding script for when parties already exist
-- Use this if you already have parties on the ledger
seedCredentialsWithExistingParties : Party -> Party -> Party -> Party -> Party -> Party -> Script ()
seedCredentialsWithExistingParties operator alice bob caDmv caDre kellerWilliams = do
  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kellerWilliams $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kellerWilliams
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Bob (Private Citizen)

  -- 1. Bob's Government ID
  let bobGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-bob"

  let bobGovIdSubject = CredentialSubject with
        id = "did:example:bob"
        claims =
          [ ("licenseNumber", "D7654321")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2019-03-20")
          ]

  bobGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2029 Mar 20) 0 0 0)
    subject = bobGovIdSubject
    proof = bobGovIdProof
    status = Active
    holder = bob
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  debug "Successfully seeded test credentials!"
  debug ("Alice credentials: " <> show [aliceGovIdCid, aliceRELicenseCid, aliceBrokerageCid])
  debug ("Bob credentials: " <> show [bobGovIdCid])

  return ()
