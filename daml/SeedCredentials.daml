-- | Seed test credentials for development and testing
-- This script creates test VerifiableCredential contracts for alice, bob, charlie, and diana
-- Alice and Bob are registered users with UserAccount contracts
-- Charlie and Diana are parties with VCs but no UserAccount contracts
module SeedCredentials where

import Daml.Script
import DA.Time
import DA.Date (date, Month(..))
import W3C.VC
import RETVN.Role

-- | Main seeding script - creates test credentials for alice, bob, charlie, and diana
-- Alice and Bob: registered users with full UserAccount contracts
-- Charlie and Diana: parties with VCs only (no UserAccount contracts)
-- Run this on a fresh ledger or after parties have been created
seedTestCredentials : Script ()
seedTestCredentials = do
  -- Allocate parties - will fail if they already exist, which is expected
  -- To handle existing parties, run this only once on fresh ledger
  operator <- allocateParty "operator"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  charlie <- allocateParty "charlie"
  diana <- allocateParty "diana"
  caDmv <- allocateParty "caDmv"
  caDre <- allocateParty "caDre"
  kw <- allocateParty "kw"

  operatorId <- validateUserId "operator"
  aliceId <- validateUserId "alice"
  bobId <- validateUserId "bob"
  caDmvId <- validateUserId "caDmv"
  caDreId <- validateUserId "caDre"
  kwId <- validateUserId "kw"
  createUser (User operatorId (Some operator)) [CanActAs operator]
  createUser (User aliceId (Some alice)) [CanActAs alice]
  createUser (User bobId (Some bob)) [CanActAs bob]
  createUser (User caDmvId (Some caDmv)) [CanActAs caDmv]
  createUser (User caDreId (Some caDre)) [CanActAs caDre]
  createUser (User kwId (Some kw)) [CanActAs kw]

  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kw $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kw
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Bob (Private Citizen)

  -- 1. Bob's Government ID
  let bobGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-bob"

  let bobGovIdSubject = CredentialSubject with
        id = "did:example:bob"
        claims =
          [ ("licenseNumber", "D7654321")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2019-03-20")
          ]

  bobGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2029 Mar 20) 0 0 0)
    subject = bobGovIdSubject
    proof = bobGovIdProof
    status = Active
    holder = bob
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Charlie (Real Estate Broker)

  -- 1. Charlie's Government ID
  let charlieGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-charlie"

  let charlieGovIdSubject = CredentialSubject with
        id = "did:example:charlie"
        claims =
          [ ("licenseNumber", "D3456789")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2018-07-10")
          ]

  charlieGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d3456789"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2030 Jul 10) 0 0 0)
    subject = charlieGovIdSubject
    proof = charlieGovIdProof
    status = Active
    holder = charlie
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Charlie's Real Estate Broker License
  let charlieBrokerLicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-broker-license-charlie"

  let charlieBrokerLicenseSubject = CredentialSubject with
        id = "did:example:charlie"
        claims =
          [ ("licenseNumber", "01234567")
          , ("licenseType", "Real Estate Broker")
          , ("state", "California")
          , ("issueDate", "2015-09-20")
          ]

  charlieBrokerLicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-broker-01234567"
    credentialType = ["VerifiableCredential", "RealEstateBrokerLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2029 Sep 20) 0 0 0)
    subject = charlieBrokerLicenseSubject
    proof = charlieBrokerLicenseProof
    status = Active
    holder = charlie
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Charlie's Brokerage Ownership
  let charlieBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-charlie"

  let charlieBrokerageSubject = CredentialSubject with
        id = "did:example:charlie"
        claims =
          [ ("ownershipId", "KW-CA-67890")
          , ("brokerLicense", "01234567")
          , ("brokerageName", "Keller Williams Realty")
          , ("role", "Managing Broker")
          ]

  charlieBrokerageCid <- submit kw $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-ownership-67890"
    credentialType = ["VerifiableCredential", "BrokerageOwnershipCredential"]
    issuer = kw
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = charlieBrokerageSubject
    proof = charlieBrokerageProof
    status = Active
    holder = charlie
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Diana (Mortgage Lender)

  -- 1. Diana's Government ID
  let dianaGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-diana"

  let dianaGovIdSubject = CredentialSubject with
        id = "did:example:diana"
        claims =
          [ ("licenseNumber", "D9876543")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2021-02-14")
          ]

  dianaGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d9876543"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2031 Feb 14) 0 0 0)
    subject = dianaGovIdSubject
    proof = dianaGovIdProof
    status = Active
    holder = diana
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Diana's Mortgage Lender License
  let dianaLenderLicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-lender-license-diana"

  let dianaLenderLicenseSubject = CredentialSubject with
        id = "did:example:diana"
        claims =
          [ ("licenseNumber", "MLO-123456")
          , ("licenseType", "Mortgage Loan Originator")
          , ("state", "California")
          , ("issueDate", "2022-05-10")
          , ("nmls", "1234567")
          ]

  dianaLenderLicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-mlo-123456"
    credentialType = ["VerifiableCredential", "MortgageLenderLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 31) 0 0 0)
    subject = dianaLenderLicenseSubject
    proof = dianaLenderLicenseProof
    status = Active
    holder = diana
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create PresentationReceipts for Alice (credential presentations to operator)
  aliceGovIdPresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-govid"

  aliceRELicensePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-re-license"

  aliceBrokeragePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:kw-affiliation-12345"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-brokerage"

  -- Create Alice's RegistrationRequest
  aliceRegistrationRequest <- submit alice $ createCmd RegistrationRequest with
    operator = operator
    user = alice
    requestedRole = RealtorAgent
    credentialPresentations = [aliceGovIdPresentation, aliceRELicensePresentation, aliceBrokeragePresentation]
    requestedAt = now

  -- Operator approves Alice's registration
  aliceAccount <- submit operator $ exerciseCmd aliceRegistrationRequest ApproveRegistration

  -- Create PresentationReceipt for Bob
  bobGovIdPresentation <- submit bob $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    holder = bob
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-bob"
    presentationProof = "mock-presentation-proof-bob-govid"

  -- Create Bob's RegistrationRequest
  bobRegistrationRequest <- submit bob $ createCmd RegistrationRequest with
    operator = operator
    user = bob
    requestedRole = PrivateCitizen
    credentialPresentations = [bobGovIdPresentation]
    requestedAt = now

  -- Operator approves Bob's registration
  bobAccount <- submit operator $ exerciseCmd bobRegistrationRequest ApproveRegistration

  -- Note: Charlie and Diana have VCs but are not registered users yet
  -- They are parties in the system but do not have UserAccount contracts

  debug "Successfully seeded test credentials and user accounts!"
  debug ("Alice credentials: " <> show [aliceGovIdCid, aliceRELicenseCid, aliceBrokerageCid])
  debug ("Bob credentials: " <> show [bobGovIdCid])
  debug ("Charlie credentials (party only, no account): " <> show [charlieGovIdCid, charlieBrokerLicenseCid, charlieBrokerageCid])
  debug ("Diana credentials (party only, no account): " <> show [dianaGovIdCid, dianaLenderLicenseCid])
  debug ("Alice account: " <> show aliceAccount)
  debug ("Bob account: " <> show bobAccount)

  return ()

-- | Alternative seeding script for when parties already exist
-- Use this if you already have parties on the ledger
seedCredentialsWithExistingParties : Party -> Party -> Party -> Party -> Party -> Party -> Script ()
seedCredentialsWithExistingParties operator alice bob caDmv caDre kellerWilliams = do
  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kellerWilliams $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kellerWilliams
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create credentials for Bob (Private Citizen)

  -- 1. Bob's Government ID
  let bobGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-bob"

  let bobGovIdSubject = CredentialSubject with
        id = "did:example:bob"
        claims =
          [ ("licenseNumber", "D7654321")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2019-03-20")
          ]

  bobGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d7654321"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2029 Mar 20) 0 0 0)
    subject = bobGovIdSubject
    proof = bobGovIdProof
    status = Active
    holder = bob
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  debug "Successfully seeded test credentials!"
  debug ("Alice credentials: " <> show [aliceGovIdCid, aliceRELicenseCid, aliceBrokerageCid])
  debug ("Bob credentials: " <> show [bobGovIdCid])

  return ()
