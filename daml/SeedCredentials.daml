-- | Seed test credentials for development and testing
-- This script creates a realistic distribution of parties:
-- - 5 Agents (RealtorAgent)
-- - 3 Brokers (RealtorBroker)
-- - 2 Masters (RealtorMaster)
-- - 3 Notaries (NotaryPublic)
-- - 1 Tax Authority (TaxAuthority)
-- - ~50 Citizens (PrivateCitizen)
module SeedCredentials where

import Daml.Script
import DA.Time
import DA.Date (date, Month(..))
import W3C.VC
import RETVN.Role

-- | Main seeding script - creates test credentials for realistic scenario
-- Agents, Brokers, Masters, Notaries, Tax Authority: full UserAccount contracts
-- Citizens: simplified parties for transaction submitters
-- Run this on a fresh ledger or after parties have been created
seedTestCredentials : Script ()
seedTestCredentials = do
  -- Allocate parties - will fail if they already exist, which is expected
  -- To handle existing parties, run this only once on fresh ledger
  operator <- allocateParty "operator"

  -- Agents (5)
  alice <- allocateParty "alice"  -- agent1
  agent2 <- allocateParty "agent2"
  agent3 <- allocateParty "agent3"
  agent4 <- allocateParty "agent4"
  agent5 <- allocateParty "agent5"

  -- Brokers (3)
  charlie <- allocateParty "charlie"  -- broker1
  broker2 <- allocateParty "broker2"
  broker3 <- allocateParty "broker3"

  -- Masters (2)
  master1 <- allocateParty "master1"
  master2 <- allocateParty "master2"

  -- Notaries (3)
  notary1 <- allocateParty "notary1"
  notary2 <- allocateParty "notary2"
  notary3 <- allocateParty "notary3"

  -- Tax Authority (1)
  taxAuth <- allocateParty "taxAuth"

  -- Issuers
  caDmv <- allocateParty "caDmv"
  caDre <- allocateParty "caDre"
  kw <- allocateParty "kw"
  reMax <- allocateParty "reMax"
  century21 <- allocateParty "century21"

  -- Create users for all parties
  operatorId <- validateUserId "operator"
  aliceId <- validateUserId "alice"
  agent2Id <- validateUserId "agent2"
  agent3Id <- validateUserId "agent3"
  agent4Id <- validateUserId "agent4"
  agent5Id <- validateUserId "agent5"
  charlieId <- validateUserId "charlie"
  broker2Id <- validateUserId "broker2"
  broker3Id <- validateUserId "broker3"
  master1Id <- validateUserId "master1"
  master2Id <- validateUserId "master2"
  notary1Id <- validateUserId "notary1"
  notary2Id <- validateUserId "notary2"
  notary3Id <- validateUserId "notary3"
  taxAuthId <- validateUserId "taxAuth"
  caDmvId <- validateUserId "caDmv"
  caDreId <- validateUserId "caDre"
  kwId <- validateUserId "kw"
  reMaxId <- validateUserId "reMax"
  century21Id <- validateUserId "century21"

  createUser (User operatorId (Some operator)) [CanActAs operator]
  createUser (User aliceId (Some alice)) [CanActAs alice]
  createUser (User agent2Id (Some agent2)) [CanActAs agent2]
  createUser (User agent3Id (Some agent3)) [CanActAs agent3]
  createUser (User agent4Id (Some agent4)) [CanActAs agent4]
  createUser (User agent5Id (Some agent5)) [CanActAs agent5]
  createUser (User charlieId (Some charlie)) [CanActAs charlie]
  createUser (User broker2Id (Some broker2)) [CanActAs broker2]
  createUser (User broker3Id (Some broker3)) [CanActAs broker3]
  createUser (User master1Id (Some master1)) [CanActAs master1]
  createUser (User master2Id (Some master2)) [CanActAs master2]
  createUser (User notary1Id (Some notary1)) [CanActAs notary1]
  createUser (User notary2Id (Some notary2)) [CanActAs notary2]
  createUser (User notary3Id (Some notary3)) [CanActAs notary3]
  createUser (User taxAuthId (Some taxAuth)) [CanActAs taxAuth]
  createUser (User caDmvId (Some caDmv)) [CanActAs caDmv]
  createUser (User caDreId (Some caDre)) [CanActAs caDre]
  createUser (User kwId (Some kw)) [CanActAs kw]
  createUser (User reMaxId (Some reMax)) [CanActAs reMax]
  createUser (User century21Id (Some century21)) [CanActAs century21]

  -- Get current time for timestamps
  now <- getTime

  -- Create credentials for Alice (Realtor Agent)

  -- 1. Alice's Government ID
  let aliceGovIdProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dmv#key-1"
        proofValue = "mock-signature-gov-id-alice"

  let aliceGovIdSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "D1234567")
          , ("licenseClass", "C")
          , ("state", "California")
          , ("issueDate", "2020-12-15")
          ]

  aliceGovIdCid <- submit caDmv $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    credentialType = ["VerifiableCredential", "GovernmentIDCredential"]
    issuer = caDmv
    issuanceDate = now
    expirationDate = Some (time (date 2028 Dec 15) 0 0 0)
    subject = aliceGovIdSubject
    proof = aliceGovIdProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 2. Alice's Real Estate License
  let aliceRELicenseProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:ca-dre#key-1"
        proofValue = "mock-signature-re-license-alice"

  let aliceRELicenseSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("licenseNumber", "02056789")
          , ("licenseType", "Real Estate Agent")
          , ("state", "California")
          , ("issueDate", "2023-01-15")
          ]

  aliceRELicenseCid <- submit caDre $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    credentialType = ["VerifiableCredential", "RealEstateLicenseCredential"]
    issuer = caDre
    issuanceDate = now
    expirationDate = Some (time (date 2027 Jun 30) 0 0 0)
    subject = aliceRELicenseSubject
    proof = aliceRELicenseProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- 3. Alice's Brokerage Affiliation
  let aliceBrokerageProof = Proof with
        proofType = "Ed25519Signature2020"
        created = now
        proofPurpose = "assertionMethod"
        verificationMethod = "did:example:kw#key-1"
        proofValue = "mock-signature-brokerage-alice"

  let aliceBrokerageSubject = CredentialSubject with
        id = "did:example:alice"
        claims =
          [ ("affiliationId", "KW-CA-12345")
          , ("agentLicense", "02056789")
          , ("brokerageName", "Keller Williams Realty")
          , ("office", "San Francisco")
          ]

  aliceBrokerageCid <- submit kw $ createCmd VerifiableCredential with
    credentialId = "urn:uuid:kw-affiliation-12345"
    credentialType = ["VerifiableCredential", "BrokerageAffiliationCredential"]
    issuer = kw
    issuanceDate = now
    expirationDate = None  -- No expiration
    subject = aliceBrokerageSubject
    proof = aliceBrokerageProof
    status = Active
    holder = alice
    verifiers = [operator]
    credentialSchema = None
    credentialContext = ["https://www.w3.org/2018/credentials/v1"]

  -- Create PresentationReceipts for Alice (credential presentations to operator)
  aliceGovIdPresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dmv-dl-d1234567"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-govid"

  aliceRELicensePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:ca-dre-agent-02056789"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-re-license"

  aliceBrokeragePresentation <- submit alice $ createCmd PresentationReceipt with
    credentialId = "urn:uuid:kw-affiliation-12345"
    holder = alice
    verifier = operator
    presentedAt = now
    challenge = "registration-challenge-alice"
    presentationProof = "mock-presentation-proof-alice-brokerage"

  -- Create Alice's RegistrationRequest
  aliceRegistrationRequest <- submit alice $ createCmd RegistrationRequest with
    operator = operator
    user = alice
    requestedRole = RealtorAgent
    credentialPresentations = [aliceGovIdPresentation, aliceRELicensePresentation, aliceBrokeragePresentation]
    requestedAt = now

  -- Operator approves Alice's registration
  aliceAccount <- submit operator $ exerciseCmd aliceRegistrationRequest ApproveRegistration

  -- Create UserAccounts for other agents (simplified, without full credentials)
  agent2Account <- submitMulti [operator, agent2] [] $ createCmd UserAccount with
    operator = operator
    user = agent2
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent3Account <- submitMulti [operator, agent3] [] $ createCmd UserAccount with
    operator = operator
    user = agent3
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent4Account <- submitMulti [operator, agent4] [] $ createCmd UserAccount with
    operator = operator
    user = agent4
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  agent5Account <- submitMulti [operator, agent5] [] $ createCmd UserAccount with
    operator = operator
    user = agent5
    role = RealtorAgent
    verificationWeight = getVerificationWeight RealtorAgent
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorAgent
    reputationCap = getReputationCap RealtorAgent
    transactionsSubmitted = 0

  -- Create UserAccounts for brokers
  charlieAccount <- submitMulti [operator, charlie] [] $ createCmd UserAccount with
    operator = operator
    user = charlie
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  broker2Account <- submitMulti [operator, broker2] [] $ createCmd UserAccount with
    operator = operator
    user = broker2
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  broker3Account <- submitMulti [operator, broker3] [] $ createCmd UserAccount with
    operator = operator
    user = broker3
    role = RealtorBroker
    verificationWeight = getVerificationWeight RealtorBroker
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorBroker
    reputationCap = getReputationCap RealtorBroker
    transactionsSubmitted = 0

  -- Create UserAccounts for masters
  master1Account <- submitMulti [operator, master1] [] $ createCmd UserAccount with
    operator = operator
    user = master1
    role = RealtorMaster
    verificationWeight = getVerificationWeight RealtorMaster
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorMaster
    reputationCap = getReputationCap RealtorMaster
    transactionsSubmitted = 0

  master2Account <- submitMulti [operator, master2] [] $ createCmd UserAccount with
    operator = operator
    user = master2
    role = RealtorMaster
    verificationWeight = getVerificationWeight RealtorMaster
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation RealtorMaster
    reputationCap = getReputationCap RealtorMaster
    transactionsSubmitted = 0

  -- Create UserAccounts for notaries
  notary1Account <- submitMulti [operator, notary1] [] $ createCmd UserAccount with
    operator = operator
    user = notary1
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  notary2Account <- submitMulti [operator, notary2] [] $ createCmd UserAccount with
    operator = operator
    user = notary2
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  notary3Account <- submitMulti [operator, notary3] [] $ createCmd UserAccount with
    operator = operator
    user = notary3
    role = NotaryPublic
    verificationWeight = getVerificationWeight NotaryPublic
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation NotaryPublic
    reputationCap = getReputationCap NotaryPublic
    transactionsSubmitted = 0

  -- Create UserAccount for tax authority
  taxAuthAccount <- submitMulti [operator, taxAuth] [] $ createCmd UserAccount with
    operator = operator
    user = taxAuth
    role = TaxAuthority
    verificationWeight = getVerificationWeight TaxAuthority
    credentialPresentations = []
    registeredAt = now
    status = AccountActive
    reputation = getStartingReputation TaxAuthority
    reputationCap = getReputationCap TaxAuthority
    transactionsSubmitted = 0

  debug "Successfully seeded test credentials and user accounts!"
  debug ("Alice account: " <> show aliceAccount)
  debug ("Agents: alice, agent2, agent3, agent4, agent5")
  debug ("Brokers: charlie, broker2, broker3")
  debug ("Masters: master1, master2")
  debug ("Notaries: notary1, notary2, notary3")
  debug ("Tax Authority: taxAuth")

  return ()
