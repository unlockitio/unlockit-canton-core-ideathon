-- | W3C Verifiable Credentials implementation in Daml
-- Based on W3C Verifiable Credentials Data Model 1.1
-- https://www.w3.org/TR/vc-data-model/
module W3C.VC where

import DA.Time
import DA.Date (date, Month(..))
import DA.Optional (fromOptional)

-- | Decentralized Identifier (DID)
-- Represents a unique identifier following the DID specification
type DID = Text

-- | Credential Status - lifecycle state of the credential
data CredentialStatus
  = Active      -- Credential is valid and active
  | Suspended   -- Temporarily suspended (can be reactivated)
  | Revoked     -- Permanently revoked (cannot be reactivated)
  deriving (Eq, Show)

-- | Credential Subject - the entity about whom claims are made
data CredentialSubject = CredentialSubject
  with
    id : DID                    -- DID of the credential subject
    claims : [(Text, Text)]     -- Key-value pairs of claims (e.g., "licenseType" -> "Realtor Agent")
  deriving (Eq, Show)

-- | Proof - cryptographic proof of the credential
data Proof = Proof
  with
    proofType : Text            -- Type of proof (e.g., "Ed25519Signature2020")
    created : Time              -- When the proof was created
    proofPurpose : Text         -- Purpose of the proof (e.g., "assertionMethod")
    verificationMethod : Text   -- DID URL of the verification method
    proofValue : Text           -- The actual proof value (signature)
  deriving (Eq, Show)

-- | Verifiable Credential Template
-- Represents a W3C Verifiable Credential on the Canton ledger
template VerifiableCredential
  with
    -- Core W3C VC fields
    credentialId : Text                 -- Unique identifier for this credential
    credentialType : [Text]             -- Types of this credential (e.g., ["VerifiableCredential", "RealEstateLicenseCredential"])
    issuer : Party                      -- The issuer of the credential (signatory)
    issuanceDate : Time                 -- When the credential was issued
    expirationDate : Optional Time      -- When the credential expires (if applicable)

    -- Credential subject
    subject : CredentialSubject         -- The entity this credential is about

    -- Proof
    proof : Proof                       -- Cryptographic proof

    -- Status and observers
    status : CredentialStatus           -- Current status of the credential
    holder : Party                      -- The holder of the credential (observer)
    verifiers : [Party]                 -- Parties who can verify this credential

    -- Additional metadata
    credentialSchema : Optional Text    -- URI to the credential schema
    credentialContext : [Text]          -- JSON-LD context URIs
  where
    ensure
      credentialId /= "" &&
      not (null credentialType) &&
      issuanceDate <= fromOptional (time (date 2100 Jan 1) 0 0 0) expirationDate

    signatory issuer
    observer holder :: verifiers

    -- | Check if credential is currently valid
    nonconsuming choice IsValid : Bool
      with
        currentTime : Time
      controller holder
      do
        let notExpired = case expirationDate of
              None -> True
              Some expDate -> currentTime < expDate
        let isActive = status == Active
        return (notExpired && isActive)

    -- | Suspend the credential (temporary revocation)
    choice Suspend : ContractId VerifiableCredential
      controller issuer
      do
        assertMsg "Credential is already revoked" (status /= Revoked)
        create this with status = Suspended

    -- | Reactivate a suspended credential
    choice Reactivate : ContractId VerifiableCredential
      controller issuer
      do
        assertMsg "Can only reactivate suspended credentials" (status == Suspended)
        create this with status = Active

    -- | Revoke the credential (permanent)
    choice Revoke : ()
      controller issuer
      do
        assertMsg "Credential is already revoked" (status /= Revoked)
        return ()

    -- | Transfer the credential to a new holder
    choice TransferCredential : ContractId VerifiableCredential
      with
        newHolder : Party
      controller holder, issuer  -- Both holder and issuer must agree
      do
        create this with holder = newHolder

    -- | Add a verifier who can check this credential
    choice AddVerifier : ContractId VerifiableCredential
      with
        verifier : Party
      controller issuer
      do
        create this with verifiers = verifier :: verifiers

    -- | Present credential to a verifier (non-consuming)
    nonconsuming choice PresentCredential : ContractId PresentationReceipt
      with
        verifier : Party
        challenge : Text          -- Challenge from the verifier to prevent replay attacks
        presentationProof : Text  -- Holder's proof of possession
      controller holder
      do
        assertMsg "Credential is not active" (status == Active)
        assertMsg "Verifier not authorized" (verifier `elem` verifiers)

        create PresentationReceipt with
          credentialId = credentialId
          holder = holder
          verifier = verifier
          presentedAt = proof.created
          challenge = challenge
          presentationProof = presentationProof

-- | Presentation Receipt - proof that a credential was presented
template PresentationReceipt
  with
    credentialId : Text
    holder : Party
    verifier : Party
    presentedAt : Time
    challenge : Text
    presentationProof : Text
  where
    signatory holder
    observer verifier

    -- | Verifier acknowledges the presentation
    choice AcknowledgePresentation : ()
      controller verifier
      do
        return ()

-- | Credential Issuance Request
-- Allows a subject to request a credential from an issuer
template CredentialIssuanceRequest
  with
    requestId : Text
    issuer : Party
    subject : Party
    requestedCredentialType : [Text]
    requestedClaims : [(Text, Text)]
    supportingDocuments : [Text]  -- URIs or hashes of supporting documents
  where
    signatory subject
    observer issuer

    -- | Issuer approves and issues the credential
    choice ApproveAndIssue : ContractId VerifiableCredential
      with
        credentialId : Text
        issuanceDate : Time
        expirationDate : Optional Time
        proof : Proof
        subjectDid : DID
        credentialSchema : Optional Text
        credentialContext : [Text]
      controller issuer
      do
        let credentialSubject = CredentialSubject with
              id = subjectDid
              claims = requestedClaims

        create VerifiableCredential with
          credentialId = credentialId
          credentialType = requestedCredentialType
          issuer = issuer
          issuanceDate = issuanceDate
          expirationDate = expirationDate
          subject = credentialSubject
          proof = proof
          status = Active
          holder = subject
          verifiers = []
          credentialSchema = credentialSchema
          credentialContext = credentialContext

    -- | Issuer rejects the credential request
    choice RejectRequest : ()
      with
        reason : Text
      controller issuer
      do
        return ()

-- | Revocation Registry Entry
-- Tracks revoked credentials for public verification
template RevocationRegistryEntry
  with
    credentialId : Text
    issuer : Party
    revokedAt : Time
    reason : Optional Text
  where
    signatory issuer

    -- | Check if a credential is in the revocation registry
    nonconsuming choice IsRevoked : Bool
      with
        queryCredentialId : Text
      controller issuer
      do
        return (queryCredentialId == credentialId)
