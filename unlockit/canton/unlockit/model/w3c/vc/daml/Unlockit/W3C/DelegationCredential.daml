module Unlockit.W3C.DelegationCredential where

import DA.Time
import DA.Date (date, Month(..))
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap
import Unlockit.Interface.W3C.BaseVerifiableCredential qualified as BaseVerifiableCredential

data DelegationClaim = DelegationClaim
  with
    delegationName : Text
    delegationPurpose : Text
  deriving (Eq, Show)

delegationClaimToAny : DelegationClaim -> BaseVerifiableCredential.AnyValue
delegationClaimToAny claim =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("delegationName", BaseVerifiableCredential.AV_Text claim.delegationName)
    , ("delegationPurpose", BaseVerifiableCredential.AV_Text claim.delegationPurpose)
    ]

template WalletDelegation
  with
    credentialId : Text
    issuer : Party
    holder : Party
    validFrom : Time
    expirationDate : Optional Time

    credentialSubjectId : Text
    claim : DelegationClaim

    proof : BaseVerifiableCredential.Proof
    status : BaseVerifiableCredential.CredentialStatus
  where
    signatory issuer, holder

    ensure
      credentialId /= "" &&
      credentialSubjectId /= "" &&
      claim.delegationPurpose /= "" &&
      validFrom <= fromOptional (time (date 2100 Jan 1) 0 0 0) expirationDate

    interface instance BaseVerifiableCredential.I for WalletDelegation where
      view = BaseVerifiableCredential.View with
        credentialId
        credentialType = ["VerifiableCredential", "WalletDelegationCredential"]
        issuer
        holder
        subject = BaseVerifiableCredential.CredentialSubject with
          id = credentialSubjectId
          claims = delegationClaimToAny claim
        proof
        status
        issuanceDate = validFrom
        expirationDate
        credentialSchema = None
        credentialContext =
          [ "https://www.w3.org/ns/credentials/v2"
          , "https://unlockit.io/contexts/wallet-delegation/v1"
          ]
