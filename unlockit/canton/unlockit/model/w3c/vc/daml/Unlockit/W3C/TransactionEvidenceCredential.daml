module Unlockit.W3C.TransactionEvidenceCredential where

import DA.Time
import DA.Date (date, Month(..))
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap
import Unlockit.Interface.W3C.BaseVerifiableCredential qualified as BaseVerifiableCredential

data TransactionEvidenceClaim = TransactionEvidenceClaim
  with
    transactionDate : Date
    askingEur : Text
    registryEur : Text
    deltaEur : Text
    dql : Text
  deriving (Eq, Show)

transactionEvidenceClaimToAny : TransactionEvidenceClaim -> BaseVerifiableCredential.AnyValue
transactionEvidenceClaimToAny claim =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("date", BaseVerifiableCredential.AV_Date claim.transactionDate)
    , ("askingEur", BaseVerifiableCredential.AV_Text claim.askingEur)
    , ("registryEur", BaseVerifiableCredential.AV_Text claim.registryEur)
    , ("deltaEur", BaseVerifiableCredential.AV_Text claim.deltaEur)
    , ("dql", BaseVerifiableCredential.AV_Text claim.dql)
    ]

template TransactionEvidenceCredential
  with
    credentialId : Text
    issuer : Party
    holder : Party
    validFrom : Time
    expirationDate : Optional Time

    -- credentialSubject.id
    credentialSubjectId : Text
    claim : TransactionEvidenceClaim

    proof : BaseVerifiableCredential.Proof
    status : BaseVerifiableCredential.CredentialStatus
  where
    signatory issuer, holder

    ensure
      credentialId /= "" &&
      credentialSubjectId /= "" &&
      claim.askingEur /= "" &&
      claim.registryEur /= "" &&
      claim.deltaEur /= "" &&
      claim.dql /= "" &&
      validFrom <= fromOptional (time (date 2100 Jan 1) 0 0 0) expirationDate

    interface instance BaseVerifiableCredential.I for TransactionEvidenceCredential where
      view = BaseVerifiableCredential.View with
        credentialId
        credentialType = ["VerifiableCredential", "TransactionEvidenceCredential"]
        issuer
        holder
        subject = BaseVerifiableCredential.CredentialSubject with
          id = credentialSubjectId
          claims = transactionEvidenceClaimToAny claim
        proof
        status
        issuanceDate = validFrom
        expirationDate
        credentialSchema = None
        credentialContext =
          [ "https://www.w3.org/ns/credentials/v2"
          , "https://example.org/contexts/transaction-evidence/v1"
          ]
