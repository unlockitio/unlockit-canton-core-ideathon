module Unlockit.W3C.TransactionValueSplitCredential where

import DA.Time
import DA.Date (date, Month(..))
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap
import Unlockit.Interface.W3C.BaseVerifiableCredential qualified as BaseVerifiableCredential

data DataCollectedFromEntry = DataCollectedFromEntry
  with
    stakeholderType : Text
    count : Int
  deriving (Eq, Show)

data ValueSplitAllocation = ValueSplitAllocation
  with
    stakeholderType : Text
    amount : Text
    percentage : Int
  deriving (Eq, Show)

data ValueSplit = ValueSplit
  with
    currency : Text
    totalAmount : Text
    allocations : [ValueSplitAllocation]
  deriving (Eq, Show)

data DataQualitySplit = DataQualitySplit
  with
    level : Text
    percentage : Int
  deriving (Eq, Show)

data UnlockedDataQualityDistribution = UnlockedDataQualityDistribution
  with
    scheme : Text
    splits : [DataQualitySplit]
  deriving (Eq, Show)

dataCollectedFromEntryToAny : DataCollectedFromEntry -> BaseVerifiableCredential.AnyValue
dataCollectedFromEntryToAny entry =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("stakeholderType", BaseVerifiableCredential.AV_Text entry.stakeholderType)
    , ("count", BaseVerifiableCredential.AV_Int entry.count)
    ]

valueSplitAllocationToAny : ValueSplitAllocation -> BaseVerifiableCredential.AnyValue
valueSplitAllocationToAny allocation =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("stakeholderType", BaseVerifiableCredential.AV_Text allocation.stakeholderType)
    , ("amount", BaseVerifiableCredential.AV_Text allocation.amount)
    , ("percentage", BaseVerifiableCredential.AV_Int allocation.percentage)
    ]

valueSplitToAny : ValueSplit -> BaseVerifiableCredential.AnyValue
valueSplitToAny valueSplit =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("currency", BaseVerifiableCredential.AV_Text valueSplit.currency)
    , ("totalAmount", BaseVerifiableCredential.AV_Text valueSplit.totalAmount)
    , ("allocations", BaseVerifiableCredential.AV_List (map valueSplitAllocationToAny valueSplit.allocations))
    ]

dataQualitySplitToAny : DataQualitySplit -> BaseVerifiableCredential.AnyValue
dataQualitySplitToAny split =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("level", BaseVerifiableCredential.AV_Text split.level)
    , ("percentage", BaseVerifiableCredential.AV_Int split.percentage)
    ]

unlockedDataQualityDistributionToAny : UnlockedDataQualityDistribution -> BaseVerifiableCredential.AnyValue
unlockedDataQualityDistributionToAny distribution =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("scheme", BaseVerifiableCredential.AV_Text distribution.scheme)
    , ("splits", BaseVerifiableCredential.AV_List (map dataQualitySplitToAny distribution.splits))
    ]

template TransactionValueSplitCredential
  with
    credentialId : Text
    issuer : Party
    holder : Party
    validFrom : Time
    expirationDate : Optional Time

    -- credentialSubject.id
    credentialSubjectId : Text

    dataCollectedFrom : [DataCollectedFromEntry]
    valueSplit : ValueSplit
    unlockedDataQualityDistribution : UnlockedDataQualityDistribution

    proof : BaseVerifiableCredential.Proof
    status : BaseVerifiableCredential.CredentialStatus
  where
    signatory issuer, holder

    ensure
      credentialId /= "" &&
      credentialSubjectId /= "" &&
      validFrom <= fromOptional (time (date 2100 Jan 1) 0 0 0) expirationDate

    interface instance BaseVerifiableCredential.I for TransactionValueSplitCredential where
      view = BaseVerifiableCredential.View with
        credentialId
        credentialType = ["VerifiableCredential", "TransactionValueSplitCredential"]
        issuer
        holder
        subject = BaseVerifiableCredential.CredentialSubject with
          id = credentialSubjectId
          claims = BaseVerifiableCredential.AV_Map $ TextMap.fromList
            [ ("dataCollectedFrom", BaseVerifiableCredential.AV_List (map dataCollectedFromEntryToAny dataCollectedFrom))
            , ("valueSplit", valueSplitToAny valueSplit)
            , ("unlockedDataQualityDistribution", unlockedDataQualityDistributionToAny unlockedDataQualityDistribution)
            ]
        proof
        status
        issuanceDate = validFrom
        expirationDate
        credentialSchema = None
        credentialContext =
          [ "https://www.w3.org/ns/credentials/v2"
          , "https://example.com/contexts/transaction-value-split/v1"
          ]
