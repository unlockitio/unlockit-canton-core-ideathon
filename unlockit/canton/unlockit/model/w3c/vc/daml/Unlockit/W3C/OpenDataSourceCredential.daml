module Unlockit.W3C.OpenDataSourceCredential where

import DA.Time
import DA.Date (date, Month(..))
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap
import Unlockit.Interface.W3C.BaseVerifiableCredential qualified as BaseVerifiableCredential

data ContentHash = ContentHash
  with
    algorithm : Text
    encoding : Text
    value : Text
  deriving (Eq, Show)

contentHashToAny : ContentHash -> BaseVerifiableCredential.AnyValue
contentHashToAny hash =
  BaseVerifiableCredential.AV_Map $ TextMap.fromList
    [ ("algorithm", BaseVerifiableCredential.AV_Text hash.algorithm)
    , ("encoding", BaseVerifiableCredential.AV_Text hash.encoding)
    , ("value", BaseVerifiableCredential.AV_Text hash.value)
    ]

template OpenDataSourceCredential
  with
    credentialId : Text
    issuer : Party
    holder : Party
    validFrom : Time
    expirationDate : Optional Time

    credentialSubjectId : Text
    sourceUrl : Text
    retrievedAt : Time
    contentHash : ContentHash

    proof : BaseVerifiableCredential.Proof
    status : BaseVerifiableCredential.CredentialStatus
  where
    signatory issuer, holder

    ensure
      credentialId /= "" &&
      credentialSubjectId /= "" &&
      sourceUrl /= "" &&
      validFrom <= fromOptional (time (date 2100 Jan 1) 0 0 0) expirationDate

    interface instance BaseVerifiableCredential.I for OpenDataSourceCredential where
      view = BaseVerifiableCredential.View with
        credentialId
        credentialType = ["VerifiableCredential", "OpenDataSourceCredential"]
        issuer
        holder
        subject = BaseVerifiableCredential.CredentialSubject with
          id = credentialSubjectId
          claims = BaseVerifiableCredential.AV_Map $ TextMap.fromList
            [ ("sourceUrl", BaseVerifiableCredential.AV_Text sourceUrl)
            , ("retrievedAt", BaseVerifiableCredential.AV_Time retrievedAt)
            , ("contentHash", contentHashToAny contentHash)
            ]
        proof
        status
        issuanceDate = validFrom
        expirationDate
        credentialSchema = None
        credentialContext =
          [ "https://www.w3.org/ns/credentials/v2"
          , "https://example.org/contexts/open-data-registry/v1"
          ]
