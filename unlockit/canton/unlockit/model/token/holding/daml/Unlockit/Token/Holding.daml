-- | Unlockit Token Holding Templates
-- Implements token holdings, transfers, transactions, and distributions
module Unlockit.Token.Holding where

import Splice.Api.Token.MetadataV1 qualified as Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 qualified as Api.Token.HoldingV1
import qualified DA.TextMap as TextMap

-- | Fixed instrument ID for Unlockit internal tokens
instrumentId : Text
instrumentId = "EUR-UNLOCKIT-INTERNAL"

-- | Main token holding template
-- Represents a party's token balance in the Unlockit system
template UnlockitHolding
  with
    issuer : Party
    owner : Party            -- Token owner
    admin : Party            -- Unlockit platform admin
    amount : Decimal         -- Token amount (1 token = 1 EUR)
    lock : Optional Api.Token.HoldingV1.Lock     -- Optional lock on tokens
  where
    signatory admin, owner
    observer getHolders lock

    ensure amount >= 0.0

    -- Implement UnlockitHolding interface
    interface instance Api.Token.HoldingV1.Holding for UnlockitHolding where
      view = Api.Token.HoldingV1.HoldingView with
        owner
        instrumentId = Api.Token.HoldingV1.InstrumentId with admin = issuer; id = instrumentId        
        amount
        lock
        meta = Api.Token.MetadataV1.Metadata
          with
            values = TextMap.fromList [
              ("Unlockit", "Unlockit")
              ]

getHolders :  Optional Api.Token.HoldingV1.Lock -> [Party]
getHolders lock = 
  case lock of
    Some a -> a.holders
    None -> []