module Unlockit.Interface.Transaction.Base.Transaction where

-- | Type synonym for `BaseTransaction`.
type I = BaseVerifiableCredential

-- | Type synonym for `View`.
type V = View

-- | View for `Transaction`.

data View = View
  with
    data Transaction = Transaction with
      -- BaseEntity
      id               : Int        -- sequence id
      externalIds  : [(Text, Text)] -- list of external id's
      -- UnlockitResource
      owner        : Party               -- User      
      
      -- Transaction-specific
      participants    : [Party]          -- Participant entities
      title           : Text
      description     : Text
      transactionType : Text             -- TransactionTypeEnum (SELL | RENTAL | EXCHANGE)
      --commissionType  : Text             -- CommissionTypeEnum (NONE | PERCENTAGE | FIXED | RENT)
      --frequencyType   : Text             -- FrequencyTypeEnum (NONE | MONTHLY | YEARLY)
      --commission      : Money
      --value           : Money
      expiresAt       : Time      
      propertyId      : Optional Text     -- Reference/ID to Property
      documentIds     : [Text]            -- Document references
  deriving (Eq, Show)

-- | Interface to expose a consistent view for any BaseTransaction implementation.
interface BaseTransaction where
  viewtype V
  {-
  getIssuer : Party
  getHolder : Party
  -}
  nonconsuming choice GetView : View
    -- ^ Retrieves the interface view.
    with
      viewer : Party
        -- ^ The party retrieving the view.
    controller viewer
    do
      pure $ view this

  nonconsuming choice GetStatus : CredentialStatus
    -- ^ Retrieves the interface Status.
    with
      viewer : Party
        -- ^ The party retrieving the Status.
    controller viewer
    do
      let v = view this
      pure v.status

  {-
  nonconsuming choice IsValid : Bool
    with currentTime : Time
    controller (getHolder this)
    do
      let v = view this
      let notExpired = case v.expirationDate of
            None -> True
            Some expDate -> currentTime < expDate
      pure (v.status == Active && notExpired)

  choice Suspend : ContractId VerifiableCredentialI
    controller (getIssuer this)
    do error "implemented by templates"

  choice Reactivate : ContractId VerifiableCredentialI
    controller (getIssuer this)
    do error "implemented by templates"

  choice Revoke : ()
    controller (getIssuer this)
    do error "implemented by templates"
  
  choice Transfer : ContractId VerifiableCredentialI
    with newHolder : Party
    controller (getHolder this, getIssuer this)
    do error "implemented by templates"

  choice AddVerifier : ContractId VerifiableCredentialI
    with verifier : Party
    controller (getIssuer this)
    do error "implemented by templates"

  choice RemoveVerifier : ContractId VerifiableCredentialI
    with verifier : Party
    controller (getIssuer this)
    do error "implemented by templates"

  choice SetExpiration : ContractId VerifiableCredentialI
    with expirationDate : Optional Time
    controller (getIssuer this)
    do error "implemented by templates"

  choice UpdateProof : ContractId VerifiableCredentialI
    with proof : Proof
    controller (getIssuer this)
    do error "implemented by templates"

  choice UpdateClaims : ContractId VerifiableCredentialI
    with claims : [(Text, Text)]
    controller (getIssuer this)
    do error "implemented by templates"
  -}
