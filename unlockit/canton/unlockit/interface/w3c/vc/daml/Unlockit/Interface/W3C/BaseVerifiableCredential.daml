module Unlockit.Interface.W3C.BaseVerifiableCredential where

-- Shared types to mirror the model package
type DID = Text

data CredentialStatus
  = Active
  | Suspended
  | Revoked
  deriving (Eq, Show)

data CredentialSubject = CredentialSubject
  with
    id : DID
    claims : [(Text, Text)]
  deriving (Eq, Show)

data Proof = Proof
  with
    proofType : Text
    created : Time
    proofPurpose : Text
    verificationMethod : Text
    proofValue : Text
  deriving (Eq, Show)

-- | Type synonym for `Instrument`.
type I = BaseVerifiableCredential

-- | Type synonym for `View`.
type V = View

-- | View for `Instrument`.

data View = View
  with
    credentialId : Text
    credentialType : [Text]
    issuer : Party
    holder : Party
    subject : CredentialSubject
    proof : Proof
    status : CredentialStatus
    verifiers : [Party]
    issuanceDate : Time
    expirationDate : Optional Time
    credentialSchema : Optional Text
    credentialContext : [Text]
  deriving (Eq, Show)

-- | Interface to expose a consistent view for any Verifiable Credential implementation.
interface BaseVerifiableCredential where
  viewtype V
  {-
  getIssuer : Party
  getHolder : Party
  -}
  nonconsuming choice GetView : View
    -- ^ Retrieves the interface view.
    with
      viewer : Party
        -- ^ The party retrieving the view.
    controller viewer
    do
      pure $ view this

  nonconsuming choice GetStatus : CredentialStatus
    -- ^ Retrieves the interface Status.
    with
      viewer : Party
        -- ^ The party retrieving the Status.
    controller viewer
    do
      let v = view this
      pure v.status

  {-
  nonconsuming choice IsValid : Bool
    with currentTime : Time
    controller (getHolder this)
    do
      let v = view this
      let notExpired = case v.expirationDate of
            None -> True
            Some expDate -> currentTime < expDate
      pure (v.status == Active && notExpired)

  choice Suspend : ContractId VerifiableCredentialI
    controller (getIssuer this)
    do error "implemented by templates"

  choice Reactivate : ContractId VerifiableCredentialI
    controller (getIssuer this)
    do error "implemented by templates"

  choice Revoke : ()
    controller (getIssuer this)
    do error "implemented by templates"
  
  choice Transfer : ContractId VerifiableCredentialI
    with newHolder : Party
    controller (getHolder this, getIssuer this)
    do error "implemented by templates"

  choice AddVerifier : ContractId VerifiableCredentialI
    with verifier : Party
    controller (getIssuer this)
    do error "implemented by templates"

  choice RemoveVerifier : ContractId VerifiableCredentialI
    with verifier : Party
    controller (getIssuer this)
    do error "implemented by templates"

  choice SetExpiration : ContractId VerifiableCredentialI
    with expirationDate : Optional Time
    controller (getIssuer this)
    do error "implemented by templates"

  choice UpdateProof : ContractId VerifiableCredentialI
    with proof : Proof
    controller (getIssuer this)
    do error "implemented by templates"

  choice UpdateClaims : ContractId VerifiableCredentialI
    with claims : [(Text, Text)]
    controller (getIssuer this)
    do error "implemented by templates"
  -}
